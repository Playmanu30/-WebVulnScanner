      "name": "SVG foreignObject iframe (rare event)",
      "pattern": "<svg><foreignObject><iframe src=\"javascript:alert(1)\"></iframe></foreignObject></svg>",
      "context": "body-context"
    },
    {
      "id": "xss-svg-xlink-href",
